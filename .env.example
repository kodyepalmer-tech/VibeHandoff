# VibeHandoff production/staging configuration.
# Portal, Postgres, S3-compatible storage, OIDC, and the artifact-host origin
# are configured from this single file.

NODE_ENV=development
LOG_LEVEL=info

# enterprise (Vibe Handoff Enterprise, the default) or public (VibeHandoff).
# Each value is a separate deployment with its own database.
# Nothing in the app copies rows from one mode into the other.
PLATFORM_MODE=enterprise

# portal | artifact | all
APP_ROLE=all
PORTAL_PORT=3000
ARTIFACT_PORT=3001

# These origins MUST differ in production so launched apps cannot share
# cookies or become same-origin with the portal API.
PORTAL_ORIGIN=http://localhost:3000
ARTIFACT_HOST_ORIGIN=http://localhost:3001

DATABASE_URL=postgres://vibehandoff:vibehandoff@localhost:5432/vibehandoff

# Long random string. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=vh_session
SESSION_TTL_SECONDS=43200

# Enterprise production requires AUTH_ADAPTER=oidc.
# Public production (PLATFORM_MODE=public) requires AUTH_ADAPTER=oauth.
# dev is local staging and tests only.
AUTH_ADAPTER=dev
ORGANIZATION_SLUG=acme
ORGANIZATION_NAME=Acme
OIDC_DEFAULT_ROLE=member

# Generic OIDC identity adapter. Used when AUTH_ADAPTER=oidc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPES=openid email profile
OIDC_ORG_CLAIM=organization
OIDC_ROLE_CLAIM=role
OIDC_DISPLAY_NAME_CLAIM=name

# Public VibeHandoff sign-in. GitHub is the wired provider.
# Register this callback on the GitHub OAuth App, with no extra path or query:
#   ${PORTAL_ORIGIN}/auth/callback
# Example: https://vibe.example.com/auth/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# These client ids are accepted by the production check. Their redirects are not wired.
OAUTH_DISCORD_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_ID=

# S3-compatible object storage. Bucket stays private.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=vibehandoff-artifacts
S3_ACCESS_KEY=vibehandoff
S3_SECRET_KEY=vibehandoff-secret
S3_FORCE_PATH_STYLE=true

# Enterprise uploads use AES-256 unless this is false.
# Local SeaweedFS does not apply SSE-S3, so Compose sets S3_SSE=false there.
# Leave it unset on real S3. Public mode does not send the encryption header.
S3_SSE=
# Seconds a private enterprise read URL stays valid. The browser still loads
# files from the artifact host; the signed URL is how that host reads the bucket.
S3_SIGNED_URL_TTL_SECONDS=120
# Public mode CDN origin, such as a CloudFront or R2 domain. Empty keeps
# sandbox traffic on the artifact host.
S3_PUBLIC_BASE_URL=

# Publish / launch policy
MAX_UPLOAD_BYTES=15728640
MAX_UNCOMPRESSED_BYTES=52428800
MAX_ZIP_FILES=500
MAX_USER_STORAGE_BYTES=209715200
LAUNCH_TICKET_TTL_SECONDS=900

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=10
