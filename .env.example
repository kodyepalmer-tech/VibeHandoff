# VibeHandoff production/staging configuration.
# Portal, Postgres, S3-compatible storage, OIDC, and the artifact-host origin
# are configured from this single file.

NODE_ENV=development
LOG_LEVEL=info

# portal | artifact | all
APP_ROLE=all
PORTAL_PORT=3000
ARTIFACT_PORT=3001

# These origins MUST differ in production so launched apps cannot share
# cookies or become same-origin with the portal API.
PORTAL_ORIGIN=http://localhost:3000
ARTIFACT_HOST_ORIGIN=http://localhost:3001

DATABASE_URL=postgres://vibehandoff:vibehandoff@localhost:5432/vibehandoff

# Long random string. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=vh_session
SESSION_TTL_SECONDS=43200

# oidc (production) or dev (local staging / tests)
AUTH_ADAPTER=dev
ORGANIZATION_SLUG=acme
ORGANIZATION_NAME=Acme
OIDC_DEFAULT_ROLE=member

# Generic OIDC identity adapter. Used when AUTH_ADAPTER=oidc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPES=openid email profile
OIDC_ORG_CLAIM=organization
OIDC_ROLE_CLAIM=role
OIDC_DISPLAY_NAME_CLAIM=name

# S3-compatible object storage. Bucket stays private.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vibehandoff-artifacts
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_FORCE_PATH_STYLE=true

# Publish / launch policy
MAX_UPLOAD_BYTES=15728640
MAX_UNCOMPRESSED_BYTES=52428800
MAX_ZIP_FILES=500
MAX_USER_STORAGE_BYTES=209715200
LAUNCH_TICKET_TTL_SECONDS=900

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=10
